flowchart TB
    Events["Chat, tool and policy events"] --> Redact["Redactor and trajectory recorder<br/>packages/trajectory"]
    Redact --> Local[".pentest/engagements/ID/<br/>trajectories/*.jsonl and blobs/"]
    Discovery["Evidence-backed discoveries"] --> Graph["graph.sqlite<br/>packages/graph"]
    Identity["Identity metadata<br/>identities.json"] --> Keychain["Native credential secrets<br/>macOS Keychain or Linux Secret Service"]
    Local --> UI["Pentest trajectory and evidence views"]
    Graph --> UI
    Local --> Export["Optional telemetry exporter<br/>packages/export"]
    Export --> Queue["Durable outbox/<br/>destination-specific cursors and retries"]
    Queue --> Service["Telemetry service scope<br/>and host-bound identity"]
    Service --> OTLP["Generic OTLP collector"]
    Service --> Course["Course audit receiver<br/>course/audit-stream/worker"]
    Course --> Custody["Seat/course token authorization<br/>digest verification and immutable record custody"]
    Custody --> Board["Live instructor board<br/>seat listing and operator publishing"]

