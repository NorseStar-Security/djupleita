{
  "name": "@dsh-pentest/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../vendor/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-connection": "link:../../vendor/deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../vendor/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "link:../../vendor/deepseek-harness/packages/client/ui-sidebar-right",
    "@deepseek-ai/dsh-client-ui-session": "link:../../vendor/deepseek-harness/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../vendor/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-store": "link:../../vendor/deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-locale": "link:../../vendor/deepseek-harness/packages/client/locale",
    "react": "18.3.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "link:../../vendor/deepseek-harness/packages/client/ui-plugin-manager",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../../vendor/deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../vendor/deepseek-harness/packages/client/ui-conversation"
  },
  "devDependencies": {
    "@types/react": "^18.3.0"
  }
}
