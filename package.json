{
  "name": "djupleita",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "security:install": "node scripts/security/install.mjs",
    "security:hooks": "node scripts/security/hooks.mjs",
    "security:scan": "node scripts/security/scan.mjs staged",
    "security:test": "node --test scripts/security/scan.test.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "build:harness": "node scripts/build-harness.mjs",
    "setup:tools": "node scripts/setup-tools.mjs",
    "import:provider": "node scripts/provider-import.mjs",
    "build:keychain": "node scripts/keychain-build.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test",
    "desktop": "node scripts/desktop.mjs",
    "web": "node scripts/web.mjs",
    "release:package": "node scripts/release.mjs",
    "release:test": "node --test scripts/release.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
