new file mode 100644
--- /dev/null
+++ b/apps/web/tests/edit-replay.e2e.ts
@@ -0,0 +1,105 @@
+// Keyless built-client exercise of editing a cold human request into a new chat.
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium, type Browser, type Page } from 'playwright'
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import {
+  launchWebScaffold, readPersistedEvents, seedSession, selectedSessionFixture,
+  watchConsole, type WebScaffold,
+} from './scaffold.ts'
+import { newEnglishPage } from './support.ts'
+
+const SOURCE = SessionId('edit-replay-web-e2e')
+const SEED = fileURLToPath(new URL('../../../snapshots/web/seeded-history/session.v3.jsonl', import.meta.url))
+const REVISED = 'Explain the earlier request using only the history in this branch.'
+const ANSWER = 'EDIT_REPLAY_DONE'
+let scaffold: WebScaffold
+let browser: Browser
+let page: Page
+let temporary: string
+let consoleState: ReturnType<typeof watchConsole>
+
+beforeAll(async () => {
+  temporary = await mkdtemp(join(tmpdir(), 'dsh-edit-replay-web-'))
+  const override = join(temporary, 'override.json')
+  await writeFile(override, JSON.stringify([{ kind: 'chunks', chunks: [
+    { type: 'block-start', index: 0, blockType: 'text' },
+    { type: 'text-delta', index: 0, text: ANSWER },
+    { type: 'block-end', index: 0, block: { type: 'text', text: ANSWER } },
+    { type: 'usage', usage: { inputTokens: 16, outputTokens: 8 } },
+    { type: 'finish', reason: { kind: 'stop' } },
+  ] }]))
+  scaffold = await launchWebScaffold({ replayFixture: join(temporary, 'override-only.jsonl'), replayOverride: override })
+  await seedSession(scaffold, await readFile(await selectedSessionFixture(SEED), 'utf8'), SOURCE)
+  browser = await chromium.launch()
+  page = await newEnglishPage(browser)
+  consoleState = watchConsole(page)
+  await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+  await page.locator('[role="treeitem"]').first().click()
+  await page.locator('[role="treeitem"]').nth(1).click()
+}, 120_000)
+
+afterAll(async () => {
+  const failures: unknown[] = []
+  await browser?.close().catch((error: unknown) => failures.push(error))
+  await scaffold?.close().catch((error: unknown) => failures.push(error))
+  if (temporary) await rm(temporary, { recursive: true, force: true }).catch((error: unknown) => failures.push(error))
+  if (failures.length) throw new AggregateError(failures, 'edit replay cleanup failed')
+})
+
+it('opens the accessible editor, cancels without mutation, and fits narrow viewports', async () => {
+  const edit = page.getByRole('button', { name: 'Edit and replay', exact: true }).first()
+  await edit.focus()
+  await edit.click()
+  const textbox = page.getByRole('textbox', { name: 'Edit and replay', exact: true })
+  await expect.poll(() => textbox.evaluate(element => element === document.activeElement)).toBe(true)
+  await textbox.fill(REVISED)
+  const form = textbox.locator('xpath=ancestor::form')
+  expect(await form.ariaSnapshot()).toMatchInlineSnapshot(`
+    "- text: Edit and replay
+    - textbox "Edit and replay": Explain the earlier request using only the history in this branch.
+    - paragraph: Creates a new chat before this request. Attachments are retained; your original chat stays available.
+    - button "Cancel"
+    - button "Replay in new chat""
+  `)
+  for (const width of [390, 1680]) {
+    await page.setViewportSize({ width, height: 1000 })
+    await textbox.scrollIntoViewIfNeeded()
+    await expect.poll(async () => {
+      const box = await form.boundingBox()
+      return box !== null && box.x >= 0 && box.x + box.width <= width
+    }).toBe(true)
+  }
+  if (process.env.DSH_REPLAY_REVIEW_DIR) {
+    await page.screenshot({ path: join(process.env.DSH_REPLAY_REVIEW_DIR, 'editor.png') })
+  }
+  await form.getByRole('button', { name: 'Cancel', exact: true }).click()
+  await expect.poll(() => textbox.count()).toBe(0)
+  await expect.poll(() => edit.evaluate(element => element === document.activeElement)).toBe(true)
+}, 60_000)
+
+it('replays through the client transport and opens the child without changing the cold source', async () => {
+  const before = await readPersistedEvents(scaffold, SOURCE)
+  const selected = before.find(event => event.type === 'user/message' && event.data.source.kind === 'user')
+  if (!selected) throw new Error('seed has no human message')
+  const edit = page.getByRole('button', { name: 'Edit and replay', exact: true }).first()
+  await edit.focus()
+  await edit.click()
+  await page.getByRole('textbox', { name: 'Edit and replay', exact: true }).fill(REVISED)
+  const settled = scaffold.whenTurnSettled(60_000)
+  await page.getByRole('button', { name: 'Replay in new chat', exact: true }).click()
+  const childId = await settled
+  expect(childId).not.toBe(SOURCE)
+  await page.getByText(ANSWER, { exact: true }).waitFor({ timeout: 15_000 })
+  await page.getByText(REVISED, { exact: true }).waitFor({ timeout: 15_000 })
+  const child = scaffold.ctx.agents.get(childId)
+  expect(child?.session.inheritedEventCount).toBe(selected.seq)
+  expect(child?.session.deriveMessages().filter(message => message.role === 'user' && message.source.kind === 'user').at(-1)?.content)
+    .toEqual([{ type: 'text', text: REVISED }])
+  expect(await readPersistedEvents(scaffold, SOURCE)).toEqual(before)
+  expect(consoleState.pageErrors).toEqual([])
+  expect(consoleState.warnings).toEqual([])
+}, 60_000)
