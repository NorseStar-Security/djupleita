new file mode 100644
--- /dev/null
+++ b/packages/api/session-controller/tests/session-replay.host.spec.ts
@@ -0,0 +1,127 @@
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, expect, it, vi } from 'vitest'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import { Context } from '@deepseek-ai/cordis'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { mountAgentLoopTestDependencies, mountAgentLoopTestHarness } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { MockAdapter, textResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { ApiSessionAgentController } from '../src/agent.ts'
+import { SessionCommandController } from '../src/commands.ts'
+import { installSessionReadTestServices } from './test-remote.ts'
+
+const contexts: Context[] = []
+const temporaryRoots: string[] = []
+afterEach(async () => {
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+  for (const root of temporaryRoots.splice(0)) await rm(root, { recursive: true, force: true })
+})
+
+async function fixture() {
+  const ctx = new Context(); contexts.push(ctx)
+  await mountAgentLoopTestDependencies(ctx)
+  const harness = await mountAgentLoopTestHarness(ctx)
+  const adapter = new MockAdapter(Array.from({ length: 8 }, () => textResponse('original answer')))
+  ctx.llm.registerAdapter(['mock'], adapter)
+  ctx.provide('workspaceRegistry', { list: () => [], archivedSessionIds: [] } as never)
+  installSessionReadTestServices(ctx)
+  ctx.provide('attachments', { admitPromptContent: async (content: unknown) => content } as never)
+  ctx.provide('agentDefaultModel', { currentSelection: () => ({ provider: 'mock', model: 'mock' }) } as never)
+  const commands = new SessionCommandController(ctx, new ApiSessionAgentController(ctx), '/workspace')
+  const source = await harness.create(SessionId('source'), { provider: 'mock', model: 'mock' })
+  return { ctx, adapter, commands, source }
+}
+
+it.each([1, 2])('replays request %i without its original answer, retaining earlier history and attachments', async request => {
+  const { ctx, adapter, commands, source } = await fixture()
+  source.followup(createUserMessage({ content: [{ type: 'text', text: 'first request' }], source: { kind: 'user' } }))
+  await source.whenIdle()
+  source.followup(createUserMessage({ content: [{ type: 'text', text: 'second request' }], source: { kind: 'user' } }))
+  await source.whenIdle()
+  const events = source.session.snapshotEvents()
+  const selected = events.filter(event => event.type === 'user/message')[request - 1]!
+  const original = JSON.stringify(events)
+  const count = adapter.requests.length
+  const inherited = vi.fn()
+  ctx.on('api-session/forked', inherited)
+  const result = await commands.fork({ sessionId: source.id, replay: { messageSeq: selected.seq, text: 'revised request' } })
+  const child = ctx.agents.get(result.sessionId)!
+  await child.whenIdle()
+  const users = child.session.deriveMessages().filter(message => message.role === 'user')
+    .flatMap(message => message.content.flatMap(part => part.type === 'text' ? [part.text] : []))
+  expect(users).toEqual(request === 1 ? ['revised request'] : ['first request', 'revised request'])
+  expect(child.session.inheritedEventCount).toBe(selected.seq)
+  expect(inherited).toHaveBeenCalledWith({ sourceId: source.id, childId: child.id, atSeq: selected.seq - 1, replayMessageSeq: selected.seq })
+  expect(adapter.requests).toHaveLength(count + 1)
+  expect(JSON.stringify(adapter.requests.at(-1)?.messages)).not.toContain(request === 1 ? 'first request' : 'second request')
+  expect(JSON.stringify(source.session.snapshotEvents())).toBe(original)
+})
+
+it('retains only the selected message’s admitted attachment references', async () => {
+  const { ctx, commands, source } = await fixture()
+  const attachment = { attachmentId: 'fixture-image', mediaType: 'image/png', bytes: 8, encodedBytes: 12, width: 1, height: 1, sha256: 'a'.repeat(64) }
+  source.followup(createUserMessage({ content: [{ type: 'text', text: 'image request' }, { type: 'image', attachment } as never], source: { kind: 'user' } }))
+  await source.whenIdle()
+  const selected = source.session.snapshotEvents().find(event => event.type === 'user/message')!
+  const admit = vi.spyOn(ctx.attachments, 'admitPromptContent')
+  const result = await commands.fork({ sessionId: source.id, replay: { messageSeq: selected.seq, text: 'edited image request' } })
+  const child = ctx.agents.get(result.sessionId)!; await child.whenIdle()
+  expect(admit).toHaveBeenCalled()
+  expect(child.session.deriveMessages().filter(message => message.role === 'user').at(-1)?.content)
+    .toEqual([{ type: 'text', text: 'edited image request' }, { type: 'image', attachment }])
+})
+
+it('refuses invalid anchors and empty edits before creating a branch', async () => {
+  const { ctx, commands, source } = await fixture()
+  source.followup(createUserMessage({ content: [{ type: 'text', text: 'request' }], source: { kind: 'user' } }))
+  await source.whenIdle()
+  const selected = source.session.snapshotEvents().find(event => event.type === 'user/message')!
+  const create = vi.spyOn(ctx.agents, 'create')
+  for (const replay of [{ messageSeq: selected.seq, text: ' ' }, { messageSeq: -1, text: 'revised' }, { messageSeq: 9999, text: 'revised' }, { messageSeq: 0, text: 'revised' }]) {
+    await expect(commands.fork({ sessionId: source.id, replay })).rejects.toMatchObject({ code: 'gateway/bad-request' })
+  }
+  await expect(commands.fork({ sessionId: source.id, atSeq: 0, replay: { messageSeq: selected.seq, text: 'revised' } })).rejects.toMatchObject({ code: 'gateway/bad-request' })
+  expect(create).not.toHaveBeenCalled()
+})
+
+it('does not admit replay after cancellation or a failed inheritance hook', async () => {
+  const { ctx, adapter, commands, source } = await fixture()
+  source.followup(createUserMessage({ content: [{ type: 'text', text: 'request' }], source: { kind: 'user' } }))
+  await source.whenIdle()
+  const selected = source.session.snapshotEvents().find(event => event.type === 'user/message')!
+  const input = { sessionId: source.id, replay: { messageSeq: selected.seq, text: 'revised' } }
+  const count = adapter.requests.length
+  await expect(commands.fork(input, AbortSignal.abort())).rejects.toBeDefined()
+  const abort = new AbortController()
+  const stop = ctx.on('api-session/forked', () => { abort.abort() })
+  await expect(commands.fork(input, abort.signal)).rejects.toBeDefined()
+  stop()
+  ctx.on('api-session/forked', () => { throw new Error('membership persistence unavailable') })
+  await expect(commands.fork(input)).rejects.toThrow('membership persistence unavailable')
+  expect(adapter.requests).toHaveLength(count)
+})
+
+it('replays a persisted source without resuming or changing that source', async () => {
+  const { ctx, commands, source } = await fixture()
+  source.followup(createUserMessage({ content: [{ type: 'text', text: 'persisted request' }], source: { kind: 'user' } }))
+  await source.whenIdle()
+  const events = source.session.snapshotEvents()
+  const coldId = SessionId('cold-source')
+  const header = { ...source.session.header, id: coldId }
+  const root = await mkdtemp(join(tmpdir(), 'dsh-replay-cold-'))
+  temporaryRoots.push(root)
+  await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  const stored = await ctx.sessionPersistence.create(header)
+  await stored.append(events)
+  await stored.close()
+  const selected = events.find(event => event.type === 'user/message')!
+  const resume = vi.spyOn(ctx.agents, 'resume')
+  const result = await commands.fork({ sessionId: coldId, replay: { messageSeq: selected.seq, text: 'revised after restart' } })
+  const child = ctx.agents.get(result.sessionId)!; await child.whenIdle()
+  expect(ctx.sessions.get(coldId)).toBeUndefined()
+  expect(resume).not.toHaveBeenCalled()
+  expect(JSON.stringify(child.session.deriveMessages())).toContain('revised after restart')
+  expect(JSON.stringify(child.session.deriveMessages())).not.toContain('persisted request')
+})
