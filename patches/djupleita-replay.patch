+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { en } from '../src/client/locale.ts'
+import { UserMessageNodeView } from '../src/client/chat/MessageItem.tsx'
+import type { ChatNodeViewProps, UserContentInput } from '../src/client/contract/slots.ts'
+import { createUserContentFixture } from './user-content-component-fixture.tsx'
+import { unusedImageLoader } from './reasoning-component-fixture.tsx'
+
+afterEach(cleanup)
+const t = makeTranslate(en, commonEn)
+function show(replayAt = vi.fn(async () => {}), allowed = true) {
+  const content = createUserContentFixture()
+  const props = {
+    t, replayAt, useAccess: () => allowed, loadImage: unusedImageLoader,
+    node: { key: 'user:7', kind: 'user', id: '7', target: 'chat', anchorSeq: 7, location: { kind: 'session' }, visibility: 'visible',
+      data: { kind: 'user', seq: 7, time: 0, content: [{ type: 'text', text: 'original request' }], source: { kind: 'user' } } },
+    renderFactorySlot: (_name: string, input: UserContentInput) => content(input, () => null, t),
+  } as unknown as ChatNodeViewProps<'user'>
+  return { replayAt, ...render(<UserMessageNodeView {...props} />) }
+}
+it('edits and submits a new branch, while cancel leaves the original message intact', async () => {
+  const { replayAt } = show()
+  fireEvent.click(screen.getByRole('button', { name: 'Edit and replay' }))
+  fireEvent.change(screen.getByRole('textbox'), { target: { value: 'revised request' } })
+  fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
+  expect(replayAt).not.toHaveBeenCalled()
+  expect(screen.getByText('original request')).toBeTruthy()
+  fireEvent.click(screen.getByRole('button', { name: 'Edit and replay' }))
+  fireEvent.change(screen.getByRole('textbox'), { target: { value: 'revised request' } })
+  await act(async () => { fireEvent.click(screen.getByRole('button', { name: 'Replay in new chat' })) })
+  expect(replayAt).toHaveBeenCalledWith(7, 'revised request', expect.any(AbortSignal))
+  expect(screen.queryByRole('textbox')).toBeNull()
+})
+it('retains the edited text after failure and refuses blank submissions', async () => {
+  const replayAt = vi.fn(async () => { throw new Error('offline') })
+  show(replayAt)
+  fireEvent.click(screen.getByRole('button', { name: 'Edit and replay' }))
+  fireEvent.change(screen.getByRole('textbox'), { target: { value: ' ' } })
+  expect((screen.getByRole('button', { name: 'Replay in new chat' }) as HTMLButtonElement).disabled).toBe(true)
+  fireEvent.change(screen.getByRole('textbox'), { target: { value: 'retained edit' } })
+  await act(async () => { fireEvent.click(screen.getByRole('button', { name: 'Replay in new chat' })) })
+  expect(screen.getByRole('alert').textContent).toContain('edited text is still available')
+  expect((screen.getByRole('textbox') as HTMLTextAreaElement).value).toBe('retained edit')
+})
+it('cancels an in-flight replay and hides replay from callers without fork access', async () => {
+  let signal: AbortSignal | undefined
+  const pending = vi.fn((_seq: number, _text: string, value: AbortSignal) => { signal = value; return new Promise<void>(() => {}) })
+  show(pending as never)
+  fireEvent.click(screen.getByRole('button', { name: 'Edit and replay' }))
+  fireEvent.click(screen.getByRole('button', { name: 'Replay in new chat' }))
+  fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
+  expect(signal?.aborted).toBe(true)
+  cleanup(); show(vi.fn(), false)
+  expect(screen.queryByRole('button', { name: 'Edit and replay' })).toBeNull()
+})
